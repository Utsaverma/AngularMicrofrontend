{
	"$schema": "./node_modules/@angular/cli/lib/config/schema.json",
	"version": 1,
	"newProjectRoot": "projects",
	"projects": {
		"insurance-app": {
			"projectType": "application",
			"schematics": {
				"@schematics/angular:component": {
					"style": "scss"
				}
			},
			"root": "projects/insurance-app",
			"sourceRoot": "projects/insurance-app/src",
			"prefix": "app",
			"architect": {
				"build": {
					"builder": "ngx-build-plus:browser",
					"options": {
						"outputPath": "dist/insurance-app",
						"index": "projects/insurance-app/src/index.html",
						"polyfills": [
							"zone.js"
						],
						"tsConfig": "projects/insurance-app/tsconfig.app.json",
						"inlineStyleLanguage": "scss",
						"assets": [
							{
								"glob": "**/*",
								"input": "projects/insurance-app/public",
								"output": "."
							}
						],
						"styles": [
							"projects/insurance-app/src/styles.scss"
						],
						"scripts": [],
						"main": "projects/insurance-app/src/main.ts",
						"extraWebpackConfig": "projects/insurance-app/webpack.config.js",
						"commonChunk": false,
						"allowedCommonJsDependencies": [
							"@angular-architects/module-federation"
						]
					},
					"configurations": {
						"production": {
							"budgets": [
								{
									"type": "initial",
									"maximumWarning": "500kB",
									"maximumError": "1MB"
								},
								{
									"type": "anyComponentStyle",
									"maximumWarning": "4kB",
									"maximumError": "8kB"
								}
							],
							"outputHashing": "all",
							"extraWebpackConfig": "projects/insurance-app/webpack.prod.config.js"
						},
						"development": {
							"optimization": false,
							"extractLicenses": false,
							"sourceMap": true
						}
					},
					"defaultConfiguration": "production"
				},
				"serve": {
					"builder": "ngx-build-plus:dev-server",
					"configurations": {
						"production": {
							"buildTarget": "insurance-app:build:production",
							"extraWebpackConfig": "projects/insurance-app/webpack.prod.config.js"
						},
						"development": {
							"buildTarget": "insurance-app:build:development"
						}
					},
					"defaultConfiguration": "development",
					"options": {
						"port": 4200,
						"publicHost": "http://localhost:4200",
						"extraWebpackConfig": "projects/insurance-app/webpack.config.js"
					}
				},
				"extract-i18n": {
					"builder": "@angular-devkit/build-angular:extract-i18n"
				},
				"test": {
					"builder": "@angular-devkit/build-angular:karma",
					"options": {
						"polyfills": [
							"zone.js",
							"zone.js/testing"
						],
						"tsConfig": "projects/insurance-app/tsconfig.spec.json",
						"inlineStyleLanguage": "scss",
						"assets": [
							{
								"glob": "**/*",
								"input": "projects/insurance-app/public"
							}
						],
						"styles": [
							"projects/insurance-app/src/styles.scss"
						],
						"scripts": []
					}
				}
			}
		},
